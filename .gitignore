# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Generated data (reproducible from seed + code version; see manifest.json)
data/test_signals/*
!data/test_signals/.gitkeep

# Program material: user-owned recordings, never committed
data/clips/*
!data/clips/.gitkeep

# The sampler's sounds: the user's sample library sorted (scripts/import_samples.py), never committed
samples/*
!samples/README.md

# Recording sessions (the app's Session view): the user's performances, never committed
sessions/

# Listening results
data/judgments/*
!data/judgments/.gitkeep

# Simulation scratch / caches
runs/
cache/
*.raw
*.prn

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local tool installs (ngspice portable, downloads)
tools/

# Generated renders and logs under reports/ (plots and summaries are kept)
reports/**/renders/
reports/**/audio/
reports/**/*.log
# the study scripts' intermediates: variant circuits they write and raw waveform dumps
# (adsr_study.py, pulse_prototype.py, ring_study.py, supply_study.py; regenerable)
reports/**/*.yaml
reports/**/*.npz

# Rust build output
target/

# KiCad's local files next to a project
*-backups/
*.kicad_prl
*.lck
fp-info-cache
_autosave-*

# Source scans too large or not ours to redistribute (their READMEs list URLs and sha256)
data/schematics/ampex_351/*.pdf
data/datasheets/tape/aes_3m_audio_open_reel_products.pdf

# The room loop's prints and mixes (docs/ROOM_LOOP_PLAN.md): regenerated from the scenes
reports/rooms/**/*.wav

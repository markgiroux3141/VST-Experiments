# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Generated data (reproducible from seed + code version; see manifest.json)
data/test_signals/*
!data/test_signals/.gitkeep

# Program material: user-owned recordings, never committed
data/clips/*
!data/clips/.gitkeep

# The sampler's sounds: the user's sample library sorted (scripts/import_samples.py), never committed
samples/*
!samples/README.md

# Recording sessions (the app's Session view): the user's performances, never committed
sessions/

# Listening results
data/judgments/*
!data/judgments/.gitkeep

# Simulation scratch / caches
runs/
cache/
*.raw
*.prn

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local tool installs (ngspice portable, downloads)
tools/

# Generated renders and logs under reports/ (plots and summaries are kept)
reports/**/renders/
reports/**/audio/
reports/**/*.log
# the study scripts' intermediates: variant circuits they write and raw waveform dumps
# (adsr_study.py, pulse_prototype.py, ring_study.py, supply_study.py; regenerable)
reports/**/*.yaml
reports/**/*.npz

# Rust build output
target/

# KiCad's local files next to a project
*-backups/
*.kicad_prl
*.lck
fp-info-cache
_autosave-*

# Source scans too large or not ours to redistribute (their READMEs list URLs and sha256)
data/schematics/ampex_351/*.pdf
data/datasheets/tape/aes_3m_audio_open_reel_products.pdf

# Generated audio under reports/ (the room loop's prints and mixes, the reverbs' impulses and
# listening files, ...): regenerated by the scripts that write it
reports/**/*.wav

# Session exports saved outside sessions/ (the user's mixes)
mixdowns/

# Multitrack stems the user works from (their own or licensed audio), never committed
stems/

# MIDI of songs for testing instruments (fan transcriptions: not ours to redistribute)
midi/*
!midi/README.md
# third-party documents supplied for the chains (CHAINS_PLAN.md): READMEs only are committed
data/schematics/helios_ia_h9/*
!data/schematics/helios_ia_h9/README.md
data/schematics/emi_tg12345/*.txt
data/schematics/api_312/*.pdf

# Reference recordings of real instruments and songs (commercial / third-party audio), never committed
real instrument samples/
assets/songs/

# Claude Code's parallel-session git worktrees (each is its own checkout of a branch)
.claude/worktrees/
